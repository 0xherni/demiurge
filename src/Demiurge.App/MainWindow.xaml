<Window x:Class="Demiurge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Demiurge"
        Icon="Assets/demiurge.ico"
        Width="1280" Height="840" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#110C0C">
    <Grid>
        <TextBlock x:Name="Loading" Text="Iniciando…" Foreground="#6E6260" FontSize="13"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="560"
                   TextAlignment="Center" />
        <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#110C0C" Visibility="Hidden" />
    </Grid>
</Window>
